# ps5-lz4: LZ4 NG and Zstd packing of PS5 games for ampr-emu-ng (PS5 Dump Forge),
# run entirely on the NAS.
# Build from the repository root:
#   docker build -t ps5-lz4:local -f nas-lz4/Dockerfile .

# ampr-emu-ng v0.4.0 (quer3q): pkg mode, writable /app0, split reads for LZ4 and
# pkg packs, plus v0.3.5's fixes. Built from upstream without local patches.
FROM rust:1.99.0-slim-trixie@sha256:24e632c09342c20abf8312cf4f61430a911c01ed3a5e4c02b87292b1c39c5273 AS ng-runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates clang-19 lld-19 llvm-19 make curl unzip python3 git \
    && rm -rf /var/lib/apt/lists/*
ENV PS5_PAYLOAD_SDK=/opt/ps5-payload-sdk LLVM_CONFIG=/usr/bin/llvm-config-19
ENV PATH=/usr/lib/llvm-19/bin:$PATH
ENV RUSTUP_TOOLCHAIN=1.99.0 RUSTUP_AUTO_INSTALL=0
RUN curl -fsSL --retry 3 https://github.com/ps5-payload-dev/sdk/releases/download/v0.43/ps5-payload-sdk.zip -o /tmp/sdk.zip \
    && echo 'a9cc9929f21b2b2c5d5b309f3bab4997067c45281c0622cf4838b1aecba66fcb  /tmp/sdk.zip' | sha256sum -c - \
    && unzip -q /tmp/sdk.zip -d /opt && rm /tmp/sdk.zip
RUN rustup component add rust-src
WORKDIR /runtime
# Pinned by commit: the checkout must be exactly this commit (its hash covers every
# file); source.tar.gz is made from it for the corresponding-source requirement.
ARG NG_COMMIT=920e9172b6bf99bd9210361b545e2953659d1e9b
RUN git init -q source && git -C source fetch -q --depth 1 https://github.com/quer3q/ampr-emu-ng "$NG_COMMIT" \
    && git -C source checkout -q FETCH_HEAD && test "$(git -C source rev-parse HEAD)" = "$NG_COMMIT" \
    && git -C source archive --format=tar.gz --prefix="ampr-emu-ng-$NG_COMMIT/" HEAD > source.tar.gz \
    && rm -rf source/.git
WORKDIR /runtime/source
RUN cargo test --workspace --locked \
    && make verify AMPR_GIT_REV=920e917 \
    && cp out/release/libSceAmpr.sprx /runtime/libSceAmpr-ng.sprx \
    && python3 -c 'import hashlib,json;from pathlib import Path;p=Path("/runtime/libSceAmpr-ng.sprx");Path("/runtime/ng-runtime.json").write_text(json.dumps({"name":"ampr-emu-ng 920e917 (v0.4.0)","commit":"920e9172b6bf99bd9210361b545e2953659d1e9b","sha256":hashlib.sha256(p.read_bytes()).hexdigest()}))'

FROM python:3.12-slim-bookworm AS forge
COPY vendor/ps5-lz4-nas/nas-lz4/install-forge.py /tmp/install-forge.py
RUN python3 /tmp/install-forge.py

FROM python:3.12-slim-bookworm AS nas-runtime
ARG MKPFS_VERSION=1.1.0
# unrar (RARLAB's freeware, from Debian non-free): extracts multi-part RAR5
# archives in the library, checking every file's CRC. lz4 and zstd: the
# Compress dialog's size estimates from a sample of the game.
RUN sed -i 's/^Components: main$/Components: main non-free/' /etc/apt/sources.list.d/debian.sources \
 && apt-get update \
 && apt-get install -y --no-install-recommends unrar libstdc++6 lz4 zstd \
 && rm -rf /var/lib/apt/lists/* \
 && unrar | head -1
RUN pip install --no-cache-dir "mkpfs==${MKPFS_VERSION}" \
 && mkpfs -V | grep -q "${MKPFS_VERSION}" \
 && python3 -c "from mkpfs.exfat import ExfatReader; import cryptography"
COPY --from=forge /usr/local/bin/ps5-dump-forge /usr/local/bin/ps5-dump-forge
COPY --from=forge /opt/ps5lz4/ /opt/ps5lz4/
COPY --from=ng-runtime /runtime/libSceAmpr-ng.sprx /opt/ps5lz4/libSceAmpr-ng.sprx
COPY --from=ng-runtime /runtime/ng-runtime.json /opt/ps5lz4/ng-runtime.json
COPY --from=ng-runtime /runtime/source.tar.gz /opt/ps5lz4/licenses/ampr-emu-ng-920e917/source.tar.gz
COPY --from=ng-runtime /runtime/source/LICENSE /opt/ps5lz4/licenses/ampr-emu-ng-920e917/LICENSE
COPY vendor/ps5-lz4-nas/nas-lz4/ps5lz4.py /opt/ps5lz4/ps5lz4.py
COPY vendor/ps5-lz4-nas/nas-lz4/ui.html /opt/ps5lz4/ui.html
COPY vendor/ps5-lz4-nas/nas-lz4/store.html /opt/ps5lz4/store.html
COPY vendor/ps5-lz4-nas/nas-lz4/ps5regist.py /opt/ps5lz4/ps5regist.py
COPY vendor/ps5-lz4-nas/nas-lz4/entrypoint.sh /usr/local/bin/ps5lz4-entrypoint
COPY vendor/ps5-lz4-nas/nas-lz4/busy.sh /usr/local/bin/ps5lz4-busy
RUN printf '#!/bin/sh\nexec python3 /opt/ps5lz4/ps5lz4.py "$@"\n' > /usr/local/bin/ps5lz4 \
 && chmod 755 /usr/local/bin/ps5lz4 /opt/ps5lz4/ps5lz4.py \
 && chmod -R a+rX /opt/ps5lz4
ENV PS5LZ4_LIBRARY=/library \
    PS5LZ4_OUTPUT=/output \
    PS5LZ4_STATE=/state \
    PYTHONUNBUFFERED=1
LABEL org.opencontainers.image.title="ps5-lz4" \
      org.opencontainers.image.description="LZ4 NG and Zstd packing of PS5 games for ampr-emu-ng on a NAS"
LABEL org.opencontainers.image.source="https://github.com/dviree/PS5-LZ4-NAS"
# Resume an unfinished queue, then idle until `docker exec ps5-lz4 ps5lz4 ...`.
CMD ["/usr/local/bin/ps5lz4-entrypoint"]

# Full-stack web UI image for ps5upload-engine.
# Serves the complete React frontend at http://<host>:19113 so any browser
# on an allowlisted IP can manage a PS5 — no native client required.
#
# Build (from the repo root, NOT engine/):
#   docker build -f engine/Dockerfile.webui -t ps5upload-engine-webui .
#
# Run (Linux server; engine/compose.yaml does the same):
#   docker run -d --network host -v ps5upload-data:/data -v /srv/pkgs:/pkgs:ro \
#     -e PS5_ADDR=192.168.1.50 \
#     -e PS5UPLOAD_ALLOW_IP=192.168.1.0/24 \
#     ps5upload-engine-webui
#
# Then open http://192.168.1.<host>:19113 in a browser on the machine whose
# IP you set in PS5UPLOAD_ALLOW_IP.
#
# DOCKER DESKTOP (macOS/Windows): the engine's loopback guard rejects
# connections from Docker's NAT bridge. You MUST set PS5UPLOAD_ALLOW_IP to
# the bridge gateway (usually 172.17.0.1) for port-forwarded connections to
# work. On Linux, prefer --network host instead. See engine/Dockerfile for
# full networking details. Note: on macOS/Windows the Docker VM is NAT'd
# and may not be able to reach the PS5 on your LAN — this is a Docker
# Desktop limitation, not an engine bug.
#
# The image also carries the two PS5 helper ELFs (ps5upload.elf and the DPI
# install daemon). The browser cannot open a socket to the console's loader
# or hold those bytes itself, so without them the web UI can install base
# games but not updates or DLC — the web UI half of #152. Override with
# PS5UPLOAD_PAYLOAD_DIR if you need to pin different ones.
#
# SECURITY: the web UI is UNAUTHENTICATED.  Anyone whose IP is in
# PS5UPLOAD_ALLOW_IP gets full control over your PS5.  Only add IPs from
# your own trusted LAN.  Never expose port 19113 to the internet.

# ── Stage 1: build the React frontend ────────────────────────────────────────
# Pinned to a release with the October 2026 Node security fixes (Brotli, TLS hostname checks).
FROM node:26.13.0-alpine AS frontend

# The client at its repo-relative place: the FAQ and Changelog screens bundle
# ../FAQ.md and ../CHANGELOG.md from the repo root.
WORKDIR /repo/client
# Copy only the client package files first so npm ci is cached
COPY client/package.json client/package-lock.json ./
RUN npm ci --silent

# Now copy the rest of the client source and build
COPY client/ .
COPY FAQ.md CHANGELOG.md ../
# Left empty, the bundle's paths are relative and one image runs at any prefix: the engine writes
# PS5UPLOAD_BASE_URL into the page when it serves it. A value here bakes that prefix in instead.
ARG PS5UPLOAD_BASE_URL=
ENV VITE_BASE_URL=$PS5UPLOAD_BASE_URL
RUN npm run build:vite

# ── Stage 2: build the Rust engine with embedded web UI ──────────────────────
FROM rust:1.99.1-alpine3.24 AS builder

# g++ compiles unrar's bundled C++ (for the ps5upload-unrar helper) against
# musl; musl target links static.
RUN apk add --no-cache musl-dev g++ make

# Keep engine/ and third_party/ at their real repo-relative positions
# rather than flattening engine/ into /build: the workspace patches
# `unrar` to ../third_party/unrar (see third_party/unrar/README.md), and
# flattening puts that path outside the image entirely.
WORKDIR /build
COPY engine/ ./engine/
COPY third_party/ ./third_party/
# The engine's own tailnet node: the C core (ps5upload-tailnet's build.rs compiles it).
COPY tailnet/ ./tailnet/
# The engine serves these guides as MCP resources (src/mcp/resources.rs).
COPY AUTOMATION.md API.md MCP.md ./
# See engine/Dockerfile: build.rs embeds these, and the web UI's update /
# DLC install is exactly what breaks without them (the web UI half of #152).
COPY payload/ ./payload/
WORKDIR /build/engine

# Populate the webui/ embed directory from the frontend build output.
# rust-embed will bake every file in this directory into the binary.
COPY --from=frontend /repo/client/dist/ ./crates/ps5upload-engine/webui/

# --locked: the image is built from a tag; the lockfile must already satisfy
# Cargo.toml (a stale lock after a squash merge fails here, not re-resolves).
# ps5upload-unrar is the RAR helper the engine starts (UnRAR is never linked into
# the engine; LICENSES/UnRAR-exception.md). It goes next to the engine below.
RUN cargo build --locked --release -p ps5upload-engine --features webui \
 && cargo build --locked --release -p ps5upload-unrar

# The runtime image is `scratch`, which has no /tmp and no home: the engine
# could not stage an uploaded package ("could not create upload dir:
# Permission denied"), cache artwork, or remember saved servers and install
# history. Make both here (scratch has no mkdir) and copy them across below.
# /data is world-writable too (sticky, like /tmp) so a `user:` override in
# Compose — common on NAS boxes, e.g. `user: "1000:1000"` (#346) — can still
# write its state there; its owner is the default runtime user.
RUN mkdir -p /rootfs/tmp /rootfs-data/data && chmod 1777 /rootfs/tmp /rootfs-data/data

# ── Stage 3: minimal scratch image ───────────────────────────────────────────
FROM nas-runtime
ARG PS5UPLOAD_BASE_URL=
COPY LICENSE /LICENSE
COPY --from=builder /build/engine/target/release/ps5upload-engine /ps5upload-engine
# The engine looks for the RAR helper next to its own binary.
COPY --from=builder /build/engine/target/release/ps5upload-unrar /ps5upload-unrar
# /tmp: staging for uploaded packages, archive extraction and the like. It
# is copied as a child of /rootfs because copying a directory applies only
# its contents: `COPY /rootfs/tmp /tmp` left a 0755 root-owned /tmp and the
# upload still failed. /data: the engine's home (HOME=/data puts its state in
# /data/.ps5upload), owned by the runtime user so it is writable.
COPY --from=builder /rootfs/ /
COPY --from=builder --chown=65532:65532 /rootfs-data/ /
ENV HOME=/data TMPDIR=/tmp PS5UPLOAD_DOCKER=1 PS5UPLOAD_BASE_URL=$PS5UPLOAD_BASE_URL
# Saved servers (with their encrypted credentials), install history, the
# artwork cache and the backport library live here. Mount a volume on it so
# they survive a container upgrade: `-v ps5upload-data:/data`.
VOLUME ["/data"]
EXPOSE 19113
# Run as an unprivileged user (65532 = nobody in distroless convention).
# scratch has no /etc/passwd, so we use a raw numeric UID — the kernel
# doesn't need a passwd entry to run a process. Port 19113 > 1024 so
# no CAP_NET_BIND_SERVICE needed.
USER 65532:65532
# scratch has no shell or HTTP client, so the engine probes itself:
# `--healthcheck` exits 0 when GET /api/jobs answers 200 (no PS5 needed).
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["/ps5upload-engine", "--healthcheck"]
COPY scripts/nas-supervisor.py /opt/ps5lz4/nas-supervisor.py
ENV PS5LZ4_LIBRARY=/ps5 PS5LZ4_OUTPUT=/zstd PS5LZ4_ZSTD_OUTPUT=/zstd PS5LZ4_STATE=/data/ps5lz4 PS5LZ4_UI_BIND=127.0.0.1
ENTRYPOINT ["python3", "/opt/ps5lz4/nas-supervisor.py"]
CMD []

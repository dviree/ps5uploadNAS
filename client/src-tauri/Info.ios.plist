<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The name under the home-screen icon, as on Android. -->
	<key>CFBundleDisplayName</key>
	<string>PS5Upload</string>
	<!-- The app's Documents folder shows in the Files app: put games there to send them. -->
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>UIFileSharingEnabled</key>
	<true/>
	<!-- Plain http to the PS5 and to the in-app engine on 127.0.0.1. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Connect to your PS5 on your home network to send games and manage the console.</string>
</dict>
</plist>

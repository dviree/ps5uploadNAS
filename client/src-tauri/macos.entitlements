<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- With the hardened runtime (Tauri's default), the mic needs this as well as
	     NSMicrophoneUsageDescription, or macOS denies it without asking. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
